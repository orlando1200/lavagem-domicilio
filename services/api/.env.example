# Copie este arquivo para .env dentro de services/api e ajuste os valores.

# Banco de dados
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lavagem_domicilio?schema=public"

# Servidor
PORT=3000
NODE_ENV=development

# Autenticacao
JWT_SECRET=local-jwt-secret-change-me
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=local-refresh-secret-change-me

# AWS / S3 (opcional em desenvolvimento local)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# Pagamentos - Mercado Pago (opcional; sem token, o modulo `payments`
# roda em modo mock/sandbox local, sem chamar a API real)
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
PAYMENT_GATEWAY_PROVIDER=mercadopago

# Google Maps Platform (opcional; sem chave, o modulo `maps` cai em
# calculo por haversine local em vez da Distance Matrix API)
GOOGLE_MAPS_API_KEY=
