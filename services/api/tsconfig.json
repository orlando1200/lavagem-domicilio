{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@database/*": ["src/database/*"],
      "@common/*": ["src/common/*"]
    }
  },
  "include": [
    "src/main.ts",
    "src/app.module.ts",
    "src/database/**/*",
    "src/common/**/*",
    "src/modules/health/**/*",
    "src/modules/marketplace/**/*",
    "src/modules/store/**/*",
    "src/modules/users/**/*",
    "src/modules/orders/**/*",
    "src/modules/drivers/**/*",
    "src/modules/coupons/**/*",
    "src/modules/payouts/**/*",
    "src/modules/deliveries/**/*",
    "src/modules/auctions/**/*",
    "src/modules/loyalty/**/*",
    "src/modules/payments/**/*",
    "src/modules/maps/**/*",
    "src/modules/zones/**/*",
    "src/modules/starter-kit/**/*",
    "src/modules/support/**/*",
    "src/modules/rental/**/*",
    "src/modules/document-verification/**/*",
    "src/modules/vehicle-catalog/**/*",
    "src/modules/wash-pricing/**/*"
  ],
  "exclude": ["node_modules", "dist", "test", "**/*.spec.ts"]
}
