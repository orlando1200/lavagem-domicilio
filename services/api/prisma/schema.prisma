model Auction {
  id            String        @id @default(uuid()) @db.Uuid
  orderId       String        @unique @map("order_id") @db.Uuid
  serviceIds    String[]      @map("service_ids")
  vehicleId     String        @map("vehicle_id") @db.Uuid
  addressId     String        @map("address_id") @db.Uuid
  status        AuctionStatus @default(open)
  maxBudget     Decimal?      @map("max_budget") @db.Decimal(12, 2)
  deadlineHours Int?          @map("deadline_hours")
  photos        String[]      @default([])
  description   String?       @db.Text
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  closedAt      DateTime?     @map("closed_at") @db.Timestamptz
  winningBidId  String?       @unique @map("winning_bid_id") @db.Uuid

  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  winningBid AuctionBid?  @relation("AuctionWinningBid", fields: [winningBidId], references: [id])
  bids       AuctionBid[]

  @@map("auctions")
}

model AuctionBid {
  id            String    @id @default(uuid()) @db.Uuid
  auctionId     String    @map("auction_id") @db.Uuid
  supplierId    String    @map("supplier_id") @db.Uuid
  amount        Decimal   @db.Decimal(12, 2)
  durationHours Int       @map("duration_hours")
  warrantyDays  Int       @map("warranty_days")
  message       String?   @db.Text
  photos        String[]
  status        BidStatus @default(pending)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  auction    Auction       @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  supplier   DriverProfile @relation(fields: [supplierId], references: [id])
  wonAuction Auction?      @relation("AuctionWinningBid")

  @@map("auction_bids")
}

// Ledger de concessoes de pontos GIUCAR: cada linha e uma concessao
// (ex.: 5% de um pedido pago). `redeemedAmount` acumula o quanto dessa
// concessao ja foi consumido por resgates (`LoyaltyRedemption`), o que
// permite consumo parcial de uma concessao (uma concessao de 50 pontos
// pode cobrir parte de um resgate de 30 e sobrar 20 para o proximo).
// `usedAt` e marcado somente quando a concessao e totalmente consumida
// (`redeemedAmount == amount`), servindo de atalho para excluir
// concessoes ja esgotadas do calculo de saldo.
model LoyaltyPoint {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  orderId        String?   @map("order_id") @db.Uuid
  amount         Int
  redeemedAmount Int       @default(0) @map("redeemed_amount")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz
  usedAt         DateTime? @map("used_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@map("loyalty_points")
}

// Registro de resgate de pontos GIUCAR como desconto em um pedido. No
// maximo um resgate por pedido (`orderId` unico) — o desconto e aplicado
// uma vez, no checkout. O consumo efetivo do saldo (quais `LoyaltyPoint`
// foram debitados) e feito no momento do resgate, mais antigos/proximos
// de expirar primeiro; este registro guarda so o total resgatado, para
// historico e para o calculo de desconto do pedido.
model LoyaltyRedemption {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  orderId   String   @unique @map("order_id") @db.Uuid
  amount    Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("loyalty_redemptions")
}

model Review {
  id           String   @id @default(uuid()) @db.Uuid
  orderId      String   @map("order_id") @db.Uuid
  authorUserId String   @map("author_user_id") @db.Uuid
  targetUserId String   @map("target_user_id") @db.Uuid
  rating       Int      @db.SmallInt
  comment      String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author User  @relation("ReviewAuthor", fields: [authorUserId], references: [id])
  target User  @relation("ReviewTarget", fields: [targetUserId], references: [id])

  @@map("reviews")
}

