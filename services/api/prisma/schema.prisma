// Schema Prisma unificado - Lavagem a Domicilio
//
// Reconstruido na rodada de recuperacao do backend (services/api).
// O schema original (~1447 linhas) foi corrompido/truncado em uma
// restauracao anterior do repositorio e esta preservado em
// `schema.prisma.corrupted-backup` para consulta manual.
// Ver docs/BACKEND_RECOVERY_AUDIT.md e docs/FASE9_CORRUPTED_MODULES.md.
//
// Este arquivo cobre o dominio completo do produto: usuarios, veiculos,
// pedidos de lavagem, pagamentos, marketplace dual (lojista -> lavador e
// lojista -> cliente), cupons, cashback, avaliacoes, suporte, zonas de
// cobertura, verificacao de documentos/rosto, kit inicial, aluguel de moto,
// fidelidade e eventos de analytics.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────────────────────────────────────
// USERS & AUTH
// ────────────────────────────────────────────────────────────────────────────

enum UserRole {
  CLIENTE
  LAVADOR
  ADMIN
}

enum UserStatus {
  active
  inactive
  blocked
  pending_verification
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  name         String     @db.VarChar(180)
  email        String     @unique @db.VarChar(180)
  phone        String?    @db.VarChar(20)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  role         UserRole
  status       UserStatus @default(active)
  avatarUrl    String?    @map("avatar_url") @db.VarChar(500)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  addresses                 Address[]
  vehicles                  Vehicle[]
  ordersAsCustomer          Order[]                @relation("OrderCustomer")
  payments                  Payment[]
  store                     Store?
  productOrders             ProductOrder[]
  cashbackBalance           CashbackBalance?
  loyaltyPoints             LoyaltyPoint[]
  reviewsGiven              Review[]               @relation("ReviewAuthor")
  reviewsReceived           Review[]               @relation("ReviewTarget")
  supportTickets            SupportTicket[]
  documentVerifications     DocumentVerification[]
  faceChecks                FaceCheck[]
  rentals                   Rental[]
  driverProfile             DriverProfile?
  couponCampaignRedemptions CouponRedemption[]
  analyticsEvents           AnalyticsEvent[]
  loyaltyRedemptions        LoyaltyRedemption[]
  notifications             Notification[]
  pushTokens                PushToken[]

  @@map("users")
}

model PushToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  platform  String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("push_tokens")
}

model Notification {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  type            String
  title           String    @db.VarChar(140)
  body            String    @db.Text
  relatedEntityId String?   @map("related_entity_id") @db.Uuid
  read            Boolean   @default(false)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Address {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  label        String?  @db.VarChar(80)
  street       String   @db.VarChar(200)
  number       String   @db.VarChar(20)
  complement   String?  @db.VarChar(120)
  neighborhood String   @db.VarChar(120)
  city         String   @db.VarChar(120)
  state        String   @db.Char(2)
  zipCode      String   @map("zip_code") @db.VarChar(12)
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@map("addresses")
}

enum VehicleType {
  carro
  moto
  caminhonete
  van
}

model Vehicle {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  type          VehicleType
  brand         String      @db.VarChar(80)
  model         String      @db.VarChar(80)
  color         String?     @db.VarChar(40)
  plate         String      @db.VarChar(10)
  catalogYearId String?     @map("catalog_year_id") @db.Uuid
  size          CarSize?
  renavam       String?     @db.VarChar(11)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders      Order[]
  catalogYear VehicleCatalogYear? @relation(fields: [catalogYearId], references: [id])
  fiscalDebts VehicleFiscalDebt[]

  @@map("vehicles")
}

/// Tipo de debito fiscal consultado pro veiculo (IPVA/multas/licenciamento
/// — modo simulado, ver FiscalDebtGateway). So consulta, nao paga: o
/// campo `status` existe pra quando o pagamento de verdade for construido
/// (Fase 2), sem precisar de migracao nova nesse momento.
enum FiscalDebtType {
  IPVA
  MULTA
  LICENCIAMENTO
}

enum FiscalDebtStatus {
  PENDING
  PAID
}

/// Snapshot persistido de um debito encontrado numa consulta — upsert por
/// `externalReference` (ex.: numero da parcela do IPVA, numero do AIT da
/// multa) pra uma nova consulta atualizar o valor sem duplicar linha, e
/// pra um pagamento futuro ter um id estavel pra referenciar.
model VehicleFiscalDebt {
  id                String           @id @default(uuid()) @db.Uuid
  vehicleId         String           @map("vehicle_id") @db.Uuid
  type              FiscalDebtType
  externalReference String           @map("external_reference") @db.VarChar(60)
  description       String           @db.VarChar(160)
  amount            Decimal          @db.Decimal(10, 2)
  dueDate           DateTime?        @map("due_date") @db.Date
  status            FiscalDebtStatus @default(PENDING)
  lastCheckedAt     DateTime         @default(now()) @map("last_checked_at") @db.Timestamptz
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, externalReference])
  @@map("vehicle_fiscal_debts")
}

/// Catalogo estruturado (Marca -> Modelo -> Ano) usado pro sistema de
/// compatibilidade de pecas (fitment). `Vehicle.catalogYearId` e opcional
/// de proposito — veiculos existentes (texto livre, sem ano) continuam
/// funcionando normalmente, so nao participam do matching exato
/// (recebem `UNKNOWN` em vez de `EXACT_MATCH`/`NOT_COMPATIBLE`).
model VehicleBrand {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(80)
  slug      String   @unique @db.VarChar(90)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  models   VehicleCatalogModel[]
  fitments ProductFitment[]

  @@map("vehicle_brands")
}

model VehicleCatalogModel {
  id          String      @id @default(uuid()) @db.Uuid
  brandId     String      @map("brand_id") @db.Uuid
  name        String      @db.VarChar(100)
  vehicleType VehicleType @map("vehicle_type")
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz

  brand    VehicleBrand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  years    VehicleCatalogYear[]
  fitments ProductFitment[]

  @@unique([brandId, name])
  @@map("vehicle_catalog_models")
}

model VehicleCatalogYear {
  id        String   @id @default(uuid()) @db.Uuid
  modelId   String   @map("model_id") @db.Uuid
  year      Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  model    VehicleCatalogModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  vehicles Vehicle[]

  @@unique([modelId, year])
  @@map("vehicle_catalog_years")
}

/// Uma linha = uma regra de compatibilidade de um Product com um
/// conjunto de veiculos (marca+modelo+faixa de anos) ou `universal=true`
/// (serve pra qualquer veiculo, ex.: cera automotiva). `yearFrom`/`yearTo`
/// null = sem limite naquele lado da faixa.
model ProductFitment {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  universal Boolean  @default(false)
  brandId   String?  @map("brand_id") @db.Uuid
  modelId   String?  @map("model_id") @db.Uuid
  yearFrom  Int?     @map("year_from")
  yearTo    Int?     @map("year_to")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  brand   VehicleBrand?        @relation(fields: [brandId], references: [id])
  model   VehicleCatalogModel? @relation(fields: [modelId], references: [id])

  @@index([productId])
  @@index([brandId, modelId])
  @@map("product_fitments")
}

// ────────────────────────────────────────────────────────────────────────────
// DRIVER (LOGISTICA) & WASHER (LAVADOR)
// ────────────────────────────────────────────────────────────────────────────

enum DriverStatus {
  draft
  pending_documents
  awaiting_kit
  active
  inactive
  rejected
  blocked
}

enum DriverType {
  MOTO_WASHER
  CAR_WASHER
  CARWASH_SHOP
}

enum ServiceType {
  DRY_WASH
  EXPRESS_WASH
  HEAVY_SERVICE
}

/// Tamanho do veiculo pra precificacao da lavagem — dimensao nova,
/// independente de `VehicleType` (um "carro" pode ser Pequeno/Hatch,
/// Medio/Sedan ou Grande/SUV).
enum CarSize {
  PEQUENO
  MEDIO
  GRANDE
}

/// Tipo de lavagem oferecido na secao "Servicos Auto" — substitui
/// DRY_WASH/EXPRESS_WASH (preco unico por tipo) como forma de precificar
/// lavagem regular. HEAVY_SERVICE (leilao) continua exatamente como esta,
/// nao usa esta matriz. SECO e a opcao mais basica/barata (primeira da
/// lista — ordem de declaracao do enum = ordem de exibicao, ja que
/// `orderBy: washType asc` no Postgres segue a ordem de declaracao de
/// um enum nativo, nao ordem alfabetica).
enum WashType {
  SECO
  EXPRESSA
  COMPLETA
  HIGIENIZACAO_INTERNA
  POLIMENTO
}

/// Matriz de precos tamanho x tipo pro modulo "Servicos Auto — Lavagem".
/// Uma linha por combinacao ativa; combinacao sem linha cadastrada fica
/// indisponivel pro cliente (nunca gera preco zero/errado).
model WashPriceMatrix {
  id       String   @id @default(uuid()) @db.Uuid
  carSize  CarSize  @map("car_size")
  washType WashType @map("wash_type")
  price    Decimal  @db.Decimal(10, 2)
  active   Boolean  @default(true)

  @@unique([carSize, washType])
  @@map("wash_price_matrix")
}

enum AuctionStatus {
  open
  closed
  cancelled
  expired
}

enum BidStatus {
  pending
  accepted
  rejected
}

model DriverProfile {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @unique @map("user_id") @db.Uuid
  driverType      DriverType    @default(CAR_WASHER) @map("driver_type")
  allowedServices ServiceType[] @map("allowed_services")
  serviceRadiusKm Decimal       @default(5) @map("service_radius_km") @db.Decimal(6, 2)
  currentZoneId   String?       @map("current_zone_id") @db.Uuid
  averageRating   Decimal?      @map("average_rating") @db.Decimal(3, 2)
  totalOrders     Int           @default(0) @map("total_orders")
  totalDeliveries Int           @default(0) @map("total_deliveries")
  status          DriverStatus  @default(draft)
  currentLatitude    Decimal?   @map("current_latitude") @db.Decimal(10, 7)
  currentLongitude   Decimal?   @map("current_longitude") @db.Decimal(10, 7)
  locationUpdatedAt  DateTime?  @map("location_updated_at") @db.Timestamptz
  pixKeyType      String?       @map("pix_key_type")
  pixKey          String?       @map("pix_key")
  bankName        String?       @map("bank_name")
  agency          String?       @map("agency")
  accountNumber   String?       @map("account_number")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  zone          Zone?              @relation(fields: [currentZoneId], references: [id])
  orders        Order[]
  rentals       Rental[]
  bids          AuctionBid[]
  starterKit    StarterKit?
  productOrders ProductOrder[]     @relation("ProductOrderWasher")
  deliveries    ProductOrder[]     @relation("ProductOrderDeliveryDriver")
  payouts       Payout[]

  @@map("driver_profiles")
}


// ────────────────────────────────────────────────────────────────────────────
// ORDERS (SERVICO DE LAVAGEM)
// ────────────────────────────────────────────────────────────────────────────

enum OrderStatus {
  pending
  searching_washer
  accepted
  en_route
  in_progress
  completed
  cancelled
}

model Order {
  id          String      @id @default(uuid()) @db.Uuid
  customerId  String      @map("customer_id") @db.Uuid
  driverId    String?     @map("driver_id") @db.Uuid
  vehicleId   String      @map("vehicle_id") @db.Uuid
  addressId   String      @map("address_id") @db.Uuid
  zoneId      String?     @map("zone_id") @db.Uuid
  status      OrderStatus @default(pending)
  serviceType ServiceType? @map("service_type")
  scheduledAt DateTime?   @map("scheduled_at") @db.Timestamptz
  startedAt   DateTime?   @map("started_at") @db.Timestamptz
  completedAt DateTime?   @map("completed_at") @db.Timestamptz
  totalAmount Decimal     @map("total_amount") @db.Decimal(12, 2)
  notes       String?     @db.Text
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  customer     User           @relation("OrderCustomer", fields: [customerId], references: [id])
  driver       DriverProfile? @relation(fields: [driverId], references: [userId])
  vehicle      Vehicle        @relation(fields: [vehicleId], references: [id])
  address      Address        @relation(fields: [addressId], references: [id])
  zone         Zone?          @relation(fields: [zoneId], references: [id])
  items        OrderItem[]
  payment      Payment?
  reviews           Review[]
  auction           Auction?
  loyaltyPoints     LoyaltyPoint[]
  loyaltyRedemption LoyaltyRedemption?

  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  name      String   @db.VarChar(180)
  price     Decimal  @db.Decimal(12, 2)
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

enum PaymentMethod {
  credit_card
  debit_card
  pix
  cash
  wallet
}

enum PaymentStatus {
  pending
  authorized
  paid
  failed
  refunded
}

// `orderId`/`productOrderId`: um pagamento referencia OU um `Order`
// (servico de lavagem) OU um `ProductOrder` (compra na loja do
// cliente), nunca os dois nem nenhum — reforcado por CHECK constraint
// na migration (ambos opcionais aqui pois cada um so se aplica a um
// dos dois fluxos).
model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  orderId        String?       @unique @map("order_id") @db.Uuid
  productOrderId String?       @unique @map("product_order_id") @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  method         PaymentMethod
  status         PaymentStatus @default(pending)
  amount         Decimal       @db.Decimal(12, 2)
  couponId       String?       @map("coupon_id") @db.Uuid
  cashbackUsed   Decimal       @default(0) @map("cashback_used") @db.Decimal(12, 2)
  externalRef    String?       @map("external_ref") @db.VarChar(120)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  order        Order?        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productOrder ProductOrder? @relation(fields: [productOrderId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id])
  coupon       Coupon?       @relation(fields: [couponId], references: [id])

  @@map("payments")
}

// ────────────────────────────────────────────────────────────────────────────
// MARKETPLACE DUAL — STORE / PRODUCT
// ────────────────────────────────────────────────────────────────────────────

enum StoreType {
  LAVADOR
  CLIENTE
}

enum LogisticsPlan {
  INTEGRATED
  OWN
}

enum StoreStatus {
  pending
  active
  inactive
  blocked
}

model Store {
  id            String        @id @default(uuid()) @db.Uuid
  ownerUserId   String        @unique @map("owner_user_id") @db.Uuid
  name          String        @db.VarChar(180)
  document      String        @db.VarChar(20)
  contactName   String?       @map("contact_name") @db.VarChar(180)
  email         String?       @db.VarChar(180)
  phone         String?       @db.VarChar(20)
  storeType     StoreType     @map("store_type")
  logisticsPlan LogisticsPlan @default(INTEGRATED) @map("logistics_plan")
  status        StoreStatus   @default(pending)
  address       Json?
  bankInfo      Json?         @map("bank_info")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  owner          User            @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  products       Product[]
  commissionPlan CommissionPlan?
  productOrders  ProductOrder[]
  payouts        Payout[]

  @@map("stores")
}

enum ProductStatus {
  draft
  pending_approval
  active
  inactive
  rejected
}

// Catalogo de destino do produto: para quem ele aparece (lavador, cliente ou ambos)
enum CatalogTarget {
  LAVADOR
  CLIENTE
  AMBOS
}

model Product {
  id               String        @id @default(uuid()) @db.Uuid
  storeId          String        @map("store_id") @db.Uuid
  name             String        @db.VarChar(180)
  slug             String        @unique @db.VarChar(200)
  description      String?       @db.Text
  sku              String?       @db.VarChar(60)
  category         String?       @db.VarChar(80)
  price            Decimal       @db.Decimal(12, 2)
  stockQuantity    Int           @default(0) @map("stock_quantity")
  status           ProductStatus @default(draft)
  catalogTarget    CatalogTarget @default(AMBOS) @map("catalog_target")
  rejectionReason  String?       @map("rejection_reason") @db.Text
  approvedAt       DateTime?     @map("approved_at") @db.Timestamptz
  approvedByUserId String?       @map("approved_by_user_id") @db.Uuid
  weightGrams      Int?          @map("weight_grams")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  store    Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items    ProductOrderItem[]
  fitments ProductFitment[]

  @@map("products")
}

enum ProductOrderStatus {
  pending
  confirmed
  shipped
  delivered
  cancelled
  refunded
}

// Status da ENTREGA de um ProductOrder por um lavador-entregador
// (Entregas Loja do Lavador). Distinto de `ProductOrderStatus`, que
// representa o status comercial do pedido (pagamento/confirmacao).
// Este enum controla o fluxo logistico: da disponibilizacao da entrega
// para aceite ate a confirmacao de entrega ao comprador.
enum ProductOrderDeliveryStatus {
  PENDING
  ACCEPTED
  ON_THE_WAY
  DELIVERED
  CANCELLED
}

model ProductOrder {
  id               String             @id @default(uuid()) @db.Uuid
  orderNumber      String             @unique @map("order_number") @db.VarChar(30)
  buyerUserId      String             @map("buyer_user_id") @db.Uuid
  buyerWasherId    String?            @map("buyer_washer_id") @db.Uuid
  storeId          String             @map("store_id") @db.Uuid
  status           ProductOrderStatus @default(pending)
  subtotal         Decimal            @db.Decimal(12, 2)
  shippingAmount   Decimal            @default(0) @map("shipping_amount") @db.Decimal(12, 2)
  commissionAmount Decimal            @default(0) @map("commission_amount") @db.Decimal(12, 2)
  totalAmount      Decimal            @map("total_amount") @db.Decimal(12, 2)
  paymentStatus    PaymentStatus      @default(pending) @map("payment_status")
  // Snapshot JSON do endereco de entrega informado no checkout (mesma
  // estrategia de `Store.address` — sem tabela relacional nova, ver
  // decisao de escopo no plano de implementacao).
  shippingAddress  Json?              @map("shipping_address")

  // ── Entrega (Entregas Loja do Lavador) ──────────────────────────────
  // Reaproveita ProductOrder em vez de criar um model separado: uma
  // entrega e sempre a logistica de um pedido de produto ja existente.
  deliveryStatus   ProductOrderDeliveryStatus @default(PENDING) @map("delivery_status")
  deliveryDriverId String?                    @map("delivery_driver_id") @db.Uuid
  assignedAt       DateTime?                  @map("assigned_at") @db.Timestamptz
  deliveredAt      DateTime?                  @map("delivered_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  buyer          User               @relation(fields: [buyerUserId], references: [id])
  buyerWasher    DriverProfile?     @relation("ProductOrderWasher", fields: [buyerWasherId], references: [userId])
  store          Store              @relation(fields: [storeId], references: [id])
  deliveryDriver DriverProfile?     @relation("ProductOrderDeliveryDriver", fields: [deliveryDriverId], references: [userId])
  items          ProductOrderItem[]
  payment        Payment?

  @@index([deliveryStatus])
  @@index([deliveryDriverId])
  @@map("product_orders")
}

model ProductOrderItem {
  id             String  @id @default(uuid()) @db.Uuid
  productOrderId String  @map("product_order_id") @db.Uuid
  productId      String  @map("product_id") @db.Uuid
  quantity       Int     @default(1)
  unitPrice      Decimal @map("unit_price") @db.Decimal(12, 2)
  totalPrice     Decimal @map("total_price") @db.Decimal(12, 2)

  productOrder ProductOrder @relation(fields: [productOrderId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id])

  @@map("product_order_items")
}

// Plano de comissao/mensalidade por loja, conforme tipo de loja e plano
// de logistica escolhido:
//   LAVADOR + INTEGRATED -> mensalidade R$150, take rate 23%
//   LAVADOR + OWN        -> mensalidade R$110, take rate 15%
//   CLIENTE + INTEGRATED -> mensalidade R$59,  take rate 18%
//   CLIENTE + OWN        -> mensalidade R$29,  take rate 12%
model CommissionPlan {
  id             String        @id @default(uuid()) @db.Uuid
  storeId        String        @unique @map("store_id") @db.Uuid
  storeType      StoreType     @map("store_type")
  logisticsPlan  LogisticsPlan @map("logistics_plan")
  monthlyFee     Decimal       @map("monthly_fee") @db.Decimal(12, 2)
  takeRate       Decimal       @map("take_rate") @db.Decimal(5, 4)
  minimumBilling Decimal       @default(0) @map("minimum_billing") @db.Decimal(12, 2)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("commission_plans")
}

// ────────────────────────────────────────────────────────────────────────────
// PAYOUTS — REPASSES (LAVADOR E LOJISTA)
// ────────────────────────────────────────────────────────────────────────────

// Nao havia model de repasse no schema original recuperado (nenhuma
// referencia a "payout"/"repayment" sobreviveu na versao truncada). Model
// novo, adicionado nesta rodada (Fase 9 - Phase B) para suportar o modulo
// `payouts`: cobre tanto repasse para lavador (`recipientWasherId`) quanto
// para lojista (`recipientStoreId`) - exatamente um dos dois deve ser
// informado por registro.
enum PayoutRecipientType {
  WASHER
  STORE
}

enum PayoutStatus {
  pending
  approved
  paid
  rejected
}

model Payout {
  id                String              @id @default(uuid()) @db.Uuid
  recipientType     PayoutRecipientType @map("recipient_type")
  recipientWasherId String?             @map("recipient_washer_id") @db.Uuid
  recipientStoreId  String?             @map("recipient_store_id") @db.Uuid
  periodStart       DateTime            @map("period_start") @db.Timestamptz
  periodEnd         DateTime            @map("period_end") @db.Timestamptz
  ordersCount       Int                 @default(0) @map("orders_count")
  grossAmount       Decimal             @map("gross_amount") @db.Decimal(12, 2)
  commissionAmount  Decimal             @default(0) @map("commission_amount") @db.Decimal(12, 2)
  netAmount         Decimal             @map("net_amount") @db.Decimal(12, 2)
  status            PayoutStatus        @default(pending)
  rejectionReason   String?             @map("rejection_reason") @db.Text
  providerReference String?             @map("provider_reference") @db.VarChar(120)
  approvedAt        DateTime?           @map("approved_at") @db.Timestamptz
  paidAt            DateTime?           @map("paid_at") @db.Timestamptz
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  recipientWasher DriverProfile? @relation(fields: [recipientWasherId], references: [userId])
  recipientStore  Store?         @relation(fields: [recipientStoreId], references: [id])

  @@index([recipientWasherId])
  @@index([recipientStoreId])
  @@index([status])
  @@map("payouts")
}

