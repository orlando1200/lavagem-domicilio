  discountValue  Decimal            @map("discount_value") @db.Decimal(12, 2)
  maxUses        Int?               @map("max_uses")
  usedCount      Int                @default(0) @map("used_count")
  minOrderAmount Decimal?           @map("min_order_amount") @db.Decimal(12, 2)
  expiresAt      DateTime?          @map("expires_at") @db.Timestamptz
  isActive       Boolean            @default(true) @map("is_active")
  campaignId     String?            @map("campaign_id") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz

  campaign    CouponCampaign?    @relation(fields: [campaignId], references: [id])
  payments    Payment[]
  redemptions CouponRedemption[]

  @@map("coupons")
}

model CouponCampaign {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(180)
